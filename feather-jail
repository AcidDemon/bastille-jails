#!/bin/sh
# feather in its jail. run as root: doas feather-jail
set -eu

JAIL=feather
RT=/tmp/xdg-acid
SRC=$RT/$JAIL
ROOT=/usr/local/bastille/jails/$JAIL/root
DST=$ROOT/tmp/xdg-jail

[ -d "$RT" ] || { echo "no $RT -- log into the compositor first" >&2; exit 1; }

WL=$(cd "$RT" && ls -1 wayland-[0-9] 2>/dev/null | head -1)
[ -n "$WL" ] || { echo "no wayland socket in $RT" >&2; exit 1; }

# the wayland socket and nothing else. no pulse, no session bus: a wallet needs
# neither, and every socket handed in is another path out of the jail. that
# also means no tray icon and no notifications, which is the intended trade.
mkdir -p "$SRC"
chown 1001:1001 "$SRC"
chmod 0700 "$SRC"
ln -f "$RT/$WL" "$SRC/wayland-0"

mkdir -p "$DST"
mount | grep -q " on $DST " || mount_nullfs "$SRC" "$DST"

jls -j "$JAIL" jid >/dev/null 2>&1 || bastille start "$JAIL" >/dev/null

# rc starts tor in the background, so on a cold start feather can win the race
# and come up with nothing to connect through. wait for the SOCKS port.
i=0
while ! jexec "$JAIL" sockstat -4lq -p 9050 2>/dev/null | grep -q 9050; do
	i=$((i + 1))
	[ "$i" -lt 100 ] || { echo "tor is not listening on 9050 in $JAIL" >&2; exit 1; }
	sleep 0.1
done

# -u not -U, matching the other launchers: host acid is uid 1001 and so is the
# jail's, so resolving the name on the host lands on the right uid either way.
# the theme env matches the host session: qt6ct reads ~/.config/qt6ct/qt6ct.conf
# through the read-only mount, which names kvantum as the style and
# Colloid-Catppuccin-Dark as the icon theme. feather's own skin stays Native so
# it does not paint a stylesheet over any of it.
exec jexec -l -u acid "$JAIL" env \
	XDG_RUNTIME_DIR=/tmp/xdg-jail \
	WAYLAND_DISPLAY=wayland-0 \
	QT_QPA_PLATFORM=wayland \
	QT_QPA_PLATFORMTHEME=qt6ct \
	QT_STYLE_OVERRIDE=kvantum \
	/usr/local/bin/feather --use-local-tor "$@"
