#!/bin/sh
#
# Spin up a GUI application jail from one of the golden baselines.
#
#   jail-new [-x PF_EXTRA_FILE] BASELINE NAME IP [STATE=JAILPATH ...]
#
#   jail-new -x ~/.jails/vesktop.pf linbase vesktop 172.16.0.40 \
#                config=home/acid/.config/vesktop
#
# Does the five things a new GUI jail needs that the baseline cannot carry:
# jail.conf, devfs ruleset, pf macro and pass rules, jailstate dataset, and the
# doas line (printed, not written). The launcher stays per-app.
#
# Safe to re-run: every step is guarded.

set -eu

PREFIX=/usr/local/bastille
JUID=1001

PF_EXTRA=""
NO_DEFAULT=0

say()  { printf '\n==> %s\n' "$1"; }
skip() { printf '    (already done, skipping)\n'; }
die()  { printf 'ERROR: %s\n' "$1" >&2; exit 1; }

usage() {
	echo "usage: jail-new [-n] [-x PF_EXTRA_FILE] BASELINE NAME IP [STATE=JAILPATH ...]" >&2
	echo "  -n  no default web rules, use only what -x supplies" >&2
	exit 1
}

# Do not name the interface. A FreeBSD jail runs /etc/rc, which renames
# e0b_<jail> to vnet0 from its own rc.conf; a Debian jail has no rc and keeps
# e0b_<jail>. Matching on the address instead works for both.
check_ip() {
	_jail=$1
	_ip=$2
	if ifconfig -j "$_jail" -a 2>/dev/null | grep -qw "inet $_ip"; then
		echo "    $_jail is up on $_ip"
	else
		echo "    interfaces in $_jail:" >&2
		ifconfig -j "$_jail" -a 2>&1 | sed 's/^/      /' >&2
		die "$_jail is not on $_ip -- a clone rewrite was missed"
	fi
}

while getopts nx: opt; do
	case "$opt" in
		n) NO_DEFAULT=1 ;;
		x) PF_EXTRA=$OPTARG ;;
		*) usage ;;
	esac
done
shift $((OPTIND - 1))

[ $# -ge 3 ] || usage

BASELINE=$1
NAME=$2
IP=$3
shift 3

JAILDIR=$PREFIX/jails/$NAME
ROOT=$JAILDIR/root
BASEDIR=$PREFIX/jails/$BASELINE

# ------------------------------------------------------------- 1. validate
say "1/8  validate"

[ "$(id -u)" = 0 ] || die "must run as root"

# e0a_<name> must fit IF_NAMESIZE (16, 15 usable) or ifconfig cannot name the
# epair, and bastille writes ifconfig_e0b_<name>_name through sysrc, which
# rejects hyphens. 11 characters is the ceiling both constraints leave.
echo "$NAME" | grep -qE '^[A-Za-z][A-Za-z0-9_]{0,10}$' \
	|| die "jail name must match ^[A-Za-z][A-Za-z0-9_]{0,10}$ (got '$NAME')"

# PF_ANCHOR is matched with index(), so the $ needs no escaping.
case "$IP" in
172.16.0.[0-9]*)
	BRIDGE=jailnatbridge
	GW=172.16.0.1
	IF_MACRO='$jail_if'
	PF_ANCHOR='# Anything else from a jail dies here'
	;;
172.16.1.[0-9]*)
	BRIDGE=jailprivbridge
	GW=172.16.1.1
	IF_MACRO='$priv_if'
	PF_ANCHOR='block in log quick on $priv_if from $priv_net to any'
	;;
*)
	die "IP must be in 172.16.0.0/24 (nat tier) or 172.16.1.0/24 (untrusted tier), got '$IP'"
	;;
esac
echo "$IP" | grep -qE '^172\.16\.[01]\.[0-9]{1,3}$' || die "IP must be a bare address, got '$IP'"
_last=${IP##*.}
[ "$_last" -ge 2 ] && [ "$_last" -le 254 ] || die "IP host part out of range: $IP"

[ -d "$BASEDIR/root" ] || die "no such baseline: $BASELINE"
[ -n "$PF_EXTRA" ] && { [ -f "$PF_EXTRA" ] || die "no such pf file: $PF_EXTRA"; }

# clone needs the target stopped. --auto would restart it afterwards, which is
# exactly what a golden jail must not do.
if jls -j "$BASELINE" jid >/dev/null 2>&1; then
	die "$BASELINE is running; stop it first (a baseline must never be up while cloned)"
fi

if [ ! -d "$JAILDIR" ]; then
	# dots are regex wildcards and .4 is a prefix of .40, so anchor on a
	# non-address character either side
	_re="(^|[^0-9.])$(echo "$IP" | sed 's/\./\\./g')([^0-9.]|$)"
	grep -qE "$_re" /etc/pf.conf 2>/dev/null && die "$IP already appears in /etc/pf.conf"
	# a Debian jail carries its address in jail.conf's exec.poststart lines, a
	# FreeBSD one in the jail's own rc.conf. Check both.
	for c in "$PREFIX"/jails/*/jail.conf "$PREFIX"/jails/*/root/etc/rc.conf; do
		[ -f "$c" ] || continue
		grep -qE "$_re" "$c" && die "$IP already used, see $c"
	done
	unset _re
fi

if [ -f "$BASEDIR/root/etc/debian_version" ]; then
	FLAVOR=linux
else
	FLAVOR=freebsd
fi

# the baseline decides: tuibase 4, guibase 20, linbase 21.
RULESET=$(sed -n 's/.*devfs_ruleset[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$BASEDIR/jail.conf" | head -1)
[ -n "$RULESET" ] || die "no devfs_ruleset in $BASEDIR/jail.conf"

echo "    $NAME <- $BASELINE ($FLAVOR), $IP on $BRIDGE, devfs $RULESET"

# ---------------------------------------------------------------- 2. clone
say "2/8  clone"
if [ -d "$JAILDIR" ]; then
	skip
else
	# CIDR, not a bare address: for a FreeBSD jail clone writes this straight
	# into the jail's rc.conf as ifconfig_vnet0="inet <value>".
	bastille clone "$BASELINE" "$NAME" "$IP/24"
fi

# ------------------------------------------------------------- 3. jail.conf
say "3/8  jail.conf"
if [ "$FLAVOR" = linux ]; then
	# clone rewrites `vnet.interface = e0b_X;` but none of the three
	# exec.poststart lines that actually assign the address, so the result is
	# internally inconsistent and still on the baseline's IP. Overwrite whole.
	if grep -q "inet $IP/24 up" "$JAILDIR/jail.conf" 2>/dev/null; then
		skip
	else
		cp "$JAILDIR/jail.conf" "$JAILDIR/jail.conf.clone-orig" 2>/dev/null || true
		cat > "$JAILDIR/jail.conf" <<EOF
$NAME {
  host.hostname = $NAME;
  path = $ROOT;
  mount.fstab = $JAILDIR/fstab;
  exec.consolelog = /var/log/bastille/${NAME}_console.log;

  devfs_ruleset = $RULESET;
  enforce_statfs = 1;
  allow.mount;
  allow.mount.devfs;
  allow.sysvipc;

  exec.start = '/bin/true';
  exec.stop = '/bin/true';
  persist;

  vnet;
  vnet.interface = e0b_$NAME;
  exec.prestart += "epair0=\\\$(ifconfig epair create) && ifconfig \\\${epair0} up name e0a_$NAME && ifconfig \\\${epair0%a}b up name e0b_$NAME";
  exec.prestart += "ifconfig $BRIDGE addm e0a_$NAME";
  exec.prestart += "ifconfig e0a_$NAME description \\"vnet0 host interface for Bastille jail $NAME\\"";
  exec.poststart += "ifconfig -j $NAME lo0 inet 127.0.0.1/8 up";
  exec.poststart += "ifconfig -j $NAME e0b_$NAME inet $IP/24 up";
  exec.poststart += "route -j $NAME add default $GW";
  exec.poststop  += "ifconfig e0a_$NAME destroy";
}
EOF
		echo "    written wholesale"
	fi
	# clone runs sysrc against <root>/etc/rc.conf, which a Debian jail has no
	# use for. it creates the file if it is missing; drop the stray.
	rm -f "$ROOT/etc/rc.conf"
	printf 'nameserver %s\n' "$GW" > "$ROOT/etc/resolv.conf"
else
	# clone's sed set is complete for a -B FreeBSD jail, including rc.conf,
	# where /etc/rc later renames e0b_<name> to vnet0 and assigns the address.
	# matched loosely: sysrc's quoting is not worth asserting on.
	grep -qE "^ifconfig_vnet0=.*$(echo "$IP" | sed 's/\./\\./g')" "$ROOT/etc/rc.conf" \
		|| die "clone did not set ifconfig_vnet0 to $IP in $ROOT/etc/rc.conf"
	echo "    clone rewrote rc.conf correctly"
fi

say "3a/8 bridge port isolation"
# kept out of the baselines: clone rewrites addm but not `private e0a_<name>`.
if grep -q "private e0a_$NAME" "$JAILDIR/jail.conf"; then
	echo "    already set"
else
	awk -v line="  exec.prestart += \"ifconfig $BRIDGE private e0a_$NAME\";" '
	/^}/ && !ins { print line; ins = 1 }
	{ print }
	' "$JAILDIR/jail.conf" > "$JAILDIR/jail.conf.tmp"
	grep -q "private e0a_$NAME" "$JAILDIR/jail.conf.tmp" || die "failed to add the private line"
	mv "$JAILDIR/jail.conf.tmp" "$JAILDIR/jail.conf"
	echo "    e0a_$NAME private on $BRIDGE"
fi

# One assertion instead of enumerating clone's individual seds: nothing anywhere
# in the new jail's config may still name the baseline. Catches a missed rewrite
# in either file, and in particular catches a clone that would share the
# baseline's jailstate dataset.
say "3b/8 assert nothing still points at $BASELINE"
_n=$(grep -c "$BASELINE" "$JAILDIR/jail.conf" || true)
[ "$_n" = 0 ] || die "$JAILDIR/jail.conf still mentions $BASELINE $_n time(s)"
_n=$(grep -c "$BASELINE" "$JAILDIR/fstab" || true)
[ "$_n" = 0 ] || die "$JAILDIR/fstab still mentions $BASELINE $_n time(s)"
echo "    clean"

# ---------------------------------------------------------------- 4. devfs
say "4/8  devfs ruleset"
if [ "$FLAVOR" = linux ]; then
	# inherited from the baseline's fstab; re-assert rather than trust it.
	grep -q "ruleset=$RULESET" "$JAILDIR/fstab" \
		|| die "no ruleset=$RULESET on the fstab devfs line -- devfs_ruleset would be inert"
	echo "    fstab carries ruleset=$RULESET"
else
	bastille config "$NAME" set devfs_ruleset "$RULESET"
	echo "    devfs_ruleset $RULESET"
fi

# ----------------------------------------------------------------- 5. boot
say "5/8  boot on"
# clone copies settings.conf, so it arrives boot=off from the baseline
bastille config "$NAME" set boot on

# ------------------------------------------------------------ 6. jailstate
say "6/8  persistent state"
if [ $# -eq 0 ]; then
	echo "    none requested"
fi
for pair in "$@"; do
	state=${pair%%=*}
	jailpath=${pair#*=}
	[ "$state" != "$pair" ] || die "expected STATE=JAILPATH, got '$pair'"

	ds=zroot/jailstate/$NAME/$state
	mp=/zroot/jailstate/$NAME/$state

	if zfs list -H -o name "$ds" >/dev/null 2>&1; then
		# a dataset left behind by a destroyed jail of the same name is reused
		# on purpose: that is how a jail gets rebuilt without losing its login
		echo "    $ds exists, reusing"
	else
		zfs create -p "$ds"
		echo "    created $ds"
	fi
	chown "$JUID:$JUID" "$mp"

	mkdir -p "$ROOT/$jailpath"
	chown "$JUID:$JUID" "$ROOT/$jailpath"

	if grep -q " $ROOT/$jailpath " "$JAILDIR/fstab"; then
		echo "    fstab entry present"
	else
		# appended directly, not via bastille mount: that needs the jail running
		printf '%s %s nullfs rw 0 0\n' "$mp" "$ROOT/$jailpath" >> "$JAILDIR/fstab"
		echo "    mounted at /$jailpath"
	fi
done

# ------------------------------------------------------------------- 7. pf
say "7/8  pf rules"
if grep -q "j_$NAME" /etc/pf.conf; then
	skip
else
	# extras come in by getline: awk -v cannot hold a literal newline.
	awk -v name="$NAME" -v ip="$IP" -v ifm="$IF_MACRO" -v anchor="$PF_ANCHOR" \
	    -v nodef="$NO_DEFAULT" -v extraf="$PF_EXTRA" '
	/^# untrusted tier/ {
		printf "%-11s= \"%s\"\n", "j_" name, ip
		print ""
		print
		next
	}
	index($0, anchor) == 1 {
		if (nodef == 0) {
			printf "# %s: web only. UDP/443 is QUIC/HTTP3\n", name
			printf "pass in quick on %s proto tcp from $j_%s to any port { 80, 443 } keep state\n", ifm, name
			printf "pass in quick on %s proto udp from $j_%s to any port 443 keep state\n", ifm, name
		}
		if (extraf != "") {
			while ((getline l < extraf) > 0) print l
			close(extraf)
		}
		print ""
		print
		next
	}
	{ print }
	' /etc/pf.conf > /tmp/pf.conf.$NAME

	grep -q "j_$NAME" /tmp/pf.conf.$NAME || die "pf.conf anchors not found, refusing to edit"

	pfctl -n -f /tmp/pf.conf.$NAME
	cp /etc/pf.conf "/etc/pf.conf.bak-$NAME"
	mv /tmp/pf.conf.$NAME /etc/pf.conf
	pfctl -f /etc/pf.conf
	echo "    backup at /etc/pf.conf.bak-$NAME"
fi

# -------------------------------------------------------- 8. start and check
say "8/8  start"
bastille stop "$NAME" 2>/dev/null || true
bastille start "$NAME"

check_ip "$NAME" "$IP"

for pair in "$@"; do
	jailpath=${pair#*=}
	jexec "$NAME" sh -c "df /$jailpath" | grep -q jailstate \
		|| die "/$jailpath is not on its jailstate dataset"
	echo "    /$jailpath on jailstate"
done

cat <<DONE

==> $NAME is up.

Left to you on purpose, once its launcher is installed:

    permit nopass acid as root cmd /usr/local/sbin/$NAME-jail

A bad edit to doas.conf costs root access, and a nopass rule is a security
decision. The rule stays narrow as long as the launcher is root-owned and not
writable by acid.
DONE
