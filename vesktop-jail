#!/bin/sh
# vesktop in its jail. run as root: doas vesktop-jail
set -eu

JAIL=vesktop
RT=/tmp/xdg-acid
SRC=$RT/$JAIL
ROOT=/usr/local/bastille/jails/$JAIL/root
DST=$ROOT/tmp/xdg-jail
COOKIE=$ROOT/home/acid/.config/pulse/cookie
BUS=$SRC/bus
PIDF=$SRC/proxy.pid

[ -d "$RT" ] || { echo "no $RT -- log into niri first" >&2; exit 1; }

# socket name changes with the compositor instance, so find it rather than assume
WL=$(cd "$RT" && ls -1 wayland-[0-9] 2>/dev/null | head -1)
[ -n "$WL" ] || { echo "no wayland socket in $RT -- is niri running?" >&2; exit 1; }

# hardlink only the sockets vesktop needs. mounting $RT wholesale would hand the
# jail dbus-1/ and keyring/, which is the thing this jail exists to stop
mkdir -p "$SRC/pulse"
chown -R 1001:1001 "$SRC"
ln -f "$RT/$WL" "$SRC/wayland-0"
ln -f "$RT/pulse/native" "$SRC/pulse/native"

# compare content, not mtime: the jail generates its own on first use and that
# is usually newer than the host's
if ! cmp -s /home/acid/.config/pulse/cookie "$COOKIE"; then
	mkdir -p "${COOKIE%/*}"
	cp /home/acid/.config/pulse/cookie "$COOKIE"
	chown 1001:1001 "$COOKIE"
fi

# session bus lives at /tmp/dbus-XXXXXXXX, name changes every login
HOSTBUS=""
for s in /tmp/dbus-*; do
	[ -S "$s" ] && HOSTBUS="unix:path=$s"
done
[ -n "$HOSTBUS" ] || { echo "no session bus socket in /tmp" >&2; exit 1; }

# --filter denies by default. org.kde.* is the tray: the name is
# org.kde.StatusNotifierItem-<pid>-1 and xdg-dbus-proxy wildcards only cut on
# dots, so nothing narrower can match a hyphenated suffix. own implies talk,
# which also covers registering with org.kde.StatusNotifierWatcher.
# NOT granted: org.freedesktop.secrets, org.freedesktop.portal.*.
if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
	:
else
	rm -f "$BUS"
	su -m acid -c "xdg-dbus-proxy '$HOSTBUS' '$BUS' --filter \
		--own=org.kde.* \
		--talk=org.freedesktop.Notifications" &
	echo $! > "$PIDF"
	i=0
	while [ ! -S "$BUS" ] && [ "$i" -lt 50 ]; do i=$((i+1)); sleep 0.1; done
	[ -S "$BUS" ] || { echo "dbus proxy did not come up" >&2; exit 1; }
	chown 1001:1001 "$BUS" 2>/dev/null || true
fi

# not bastille mount: that writes fstab, and /tmp is empty at boot when the jail
# autostarts, so the stale entry would break startup
mkdir -p "$DST"
mount | grep -q " on $DST " || mount_nullfs "$SRC" "$DST"

# -u not -U: jexec resolves -U with FreeBSD getpwnam, which wants /etc/pwd.db,
# and a debian jail has only the plain /etc/passwd.
# --in-process-gpu: without it chromium waits ~20s then reports "GPU process
# isn't usable". --no-sandbox: no user namespaces under linuxulator.
exec jexec -l -u acid "$JAIL" env \
	XDG_RUNTIME_DIR=/tmp/xdg-jail \
	WAYLAND_DISPLAY=wayland-0 \
	PULSE_SERVER=unix:/tmp/xdg-jail/pulse/native \
	DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/xdg-jail/bus \
	XDG_CURRENT_DESKTOP=niri \
	/usr/bin/vesktop --no-sandbox --ozone-platform=wayland --in-process-gpu "$@"
